{
  "name": "snake_controller",
  "version": "1.0.0",
  "description": "A modern Snake game with cross-device multiplayer functionality using Firebase",
  "scripts": {
    "start": "npx serve -s public",
    "lint": "eslint public tests",
    "check:globals": "node scripts/check-globals.mjs",
    "format": "prettier --write \"public/**/*.{js,css,html}\" \"tests/**/*.js\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore,database \"vitest run --config vitest.rules.config.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryamangodara/snake_controller.git"
  },
  "homepage": "https://github.com/aryamangodara/snake_controller#readme",
  "author": "Aryaman Godara <godara.aryaman@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.0",
    "firebase": "^12.15.0",
    "firebase-tools": "^13.0.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.3",
    "vitest": "^1.6.0"
  }
}
